# Compiler & Flags
CXX = clang++
CXXFLAGS = -std=c++23 -Wall -Wextra -MMD -MP

# Archive utility for static libraries
AR = ar
ARFLAGS = rcs

# Detect OS and architecture for vcpkg paths
UNAME_S := $(shell uname -s)
UNAME_M := $(shell uname -m)

# Determine the vcpkg triplet name
ifeq ($(UNAME_S),Darwin)
    ifeq ($(UNAME_M),arm64)
        TRIPLET = arm64-osx
    else
        TRIPLET = x64-osx
    endif
else
    # Default fallback for Linux/Codecrafters environments
    ifeq ($(UNAME_M),x86_64)
        TRIPLET = x64-linux
    else
        TRIPLET = arm64-linux
    endif
endif

# Resolve paths to vcpkg dependencies
VCPKG_INCLUDE = vcpkg_installed/$(TRIPLET)/include
VCPKG_LIB = vcpkg_installed/$(TRIPLET)/lib

# Include paths
INCLUDES = -Isrc
ifneq ($(wildcard $(VCPKG_INCLUDE)),)
    INCLUDES += -I$(VCPKG_INCLUDE)
endif

# Linker flags
LDFLAGS = -lpthread
ifneq ($(wildcard $(VCPKG_LIB)),)
    LDFLAGS := -L$(VCPKG_LIB) $(LDFLAGS)
endif

# Directories & Target Executable
SRC_DIR = src
BUILD_DIR = build
TARGET = $(BUILD_DIR)/redis

# Object files
RESP_OBJ = $(BUILD_DIR)/resp.o
COMMAND_OBJ = $(BUILD_DIR)/command.o
MAIN_OBJ = $(BUILD_DIR)/main.o

OBJS = $(RESP_OBJ) $(COMMAND_OBJ) $(MAIN_OBJ)

# Static libraries
RESP_LIB = $(BUILD_DIR)/libresp.a
COMMAND_LIB = $(BUILD_DIR)/libcommand.a
LIBS = $(RESP_LIB) $(COMMAND_LIB)

# Dependency files generated by compiler (-MMD -MP)
DEPS = $(OBJS:.o=.d)

# Default target
all: $(TARGET)

# Link the final executable using static libraries and main object
$(TARGET): $(MAIN_OBJ) $(LIBS)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(MAIN_OBJ) -L$(BUILD_DIR) -lcommand -lresp -o $@ $(LDFLAGS)

# Static library target for RESP module
$(RESP_LIB): $(RESP_OBJ)
	@mkdir -p $(BUILD_DIR)
	$(AR) $(ARFLAGS) $@ $<

# Static library target for Command module
$(COMMAND_LIB): $(COMMAND_OBJ)
	@mkdir -p $(BUILD_DIR)
	$(AR) $(ARFLAGS) $@ $<

# Specific object file targets with explicit header dependencies
$(BUILD_DIR)/resp.o: $(SRC_DIR)/resp.cpp $(SRC_DIR)/resp.h
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/command.o: $(SRC_DIR)/command.cpp $(SRC_DIR)/command.h $(SRC_DIR)/resp.h
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/main.o: $(SRC_DIR)/main.cpp $(SRC_DIR)/command.h $(SRC_DIR)/resp.h
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Generic pattern rule for compiling any other cpp source files
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Convenience aliases for object targets and libraries
resp.o: $(RESP_OBJ)
command.o: $(COMMAND_OBJ)
main.o: $(MAIN_OBJ)

libresp.a: $(RESP_LIB)
libcommand.a: $(COMMAND_LIB)

resp: $(RESP_LIB)
command: $(COMMAND_LIB)

# Include generated header dependency files (.d)
-include $(DEPS)

# Clean build directory
clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean resp.o command.o main.o libresp.a libcommand.a resp command
